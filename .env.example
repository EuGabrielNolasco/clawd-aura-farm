# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave anon é pública por design: a segurança vem das
# regras em supabase/schema.sql. NUNCA coloque a chave service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
